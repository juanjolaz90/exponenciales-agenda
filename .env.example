# URL pública de la app (sin barra final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Mínimo 32 caracteres aleatorios. Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Emails que pueden entrar al panel (separados por comas)
ALLOWED_EMAILS=juanjos.lazcano@gmail.com

# Base de datos. Local: archivo. Producción: Turso (libsql://xxx.turso.io) + token
DATABASE_URL=file:./data/agenda.db
DATABASE_AUTH_TOKEN=

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo "Aplicación web")
# URI de redirección autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HubSpot private app (Configuración → Integraciones → Aplicaciones privadas)
HUBSPOT_ACCESS_TOKEN=
